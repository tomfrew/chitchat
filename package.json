{
  "name": "chitchat",
  "version": "0.1.0",
  "description": "Self-hosted MCP server for multi-agent coordination.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "bun": ">=1.1"
  },
  "bin": {
    "chitchat": "./bin/chitchat.ts"
  },
  "files": ["bin", "src", "skills", "tsconfig.json"],
  "scripts": {
    "dev": "bun --watch run bin/chitchat.ts serve",
    "start": "bun run bin/chitchat.ts serve",
    "typecheck": "tsc -p . --noEmit",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "build": "bun build bin/chitchat.ts --compile --target=bun --outfile dist/chitchat"
  },
  "dependencies": {
    "@hono/node-server": "^1.12.0",
    "@modelcontextprotocol/sdk": "^1.0.0",
    "commander": "^12.0.0",
    "hono": "^4.6.0",
    "ink": "^7.0.1",
    "ink-text-input": "^6.0.0",
    "react": "^19.2.5",
    "ulid": "^2.3.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/bun": "^1.1.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.14",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0",
    "typescript": "^5.6.0"
  }
}
